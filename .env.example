# Lomeza Communication Platform — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# Supabase project configuration (public anon/publishable key only).
# Never put the service-role key here; it must not ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development-only demo authentication mode.
# Set to 'true' to enable the demo employee selector while running locally
# in development (import.meta.env.DEV === true).
#
# The public Vercel prototype uses the dedicated Vite "prototype" build mode
# (npm run build:prototype) instead of this variable. It runs with fictional,
# in-memory data and does not require any Supabase values.
#
# Normal production builds always require real Supabase authentication.
VITE_DEMO_MODE=false
