# Lomeza Communication Platform — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# Supabase project configuration (public anon/publishable key only).
# Never put the service-role key here; it must not ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development-only demo authentication mode.
# Set to 'true' to enable demo mode. Demo mode only activates when running
# in development (import.meta.env.DEV === true); production builds always
# require real Supabase authentication regardless of this value.
VITE_DEMO_MODE=false
